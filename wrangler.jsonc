{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lane-vm-sovereign-worker",
  "main": "src/native/cloudflare_headless_repo_auditor.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "provenance.albertlane.net/*", "custom_domain": true }
  ],
  "vars": {
    "AUTHOR": "Albert Dale Lane",
    "PROVENANCE_DOMAIN": "albertlane.net",
    "SEC_WHISTLEBLOWER_REF": "17684-273-411-436",
    "MAGIC_HEADER": "0x3F8F9A1B2C3D",
    "RFC_STANDARD": "RFC 0103"
  }
}
